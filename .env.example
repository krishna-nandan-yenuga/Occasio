# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# mock | anthropic  (mock needs no API key)
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5-5
LLM_CHEAP_MODEL=claude-haiku-5-5

# dev | prod
APP_ENV=dev

DATABASE_PATH=occasio.db
# Per client IP, on routes that call the LLM
RATE_LIMIT_PER_MINUTE=10
